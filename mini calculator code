#include<iostream>
using namespace std;
int main(){
    int a;
    cout<<"enter the value of a:"<<endl;
    cin>>a;
    int b;
    cout<<"enter the value of b:"<<endl;
    cin>>b;
    char op;
    cout<<"enter the desired operation"<<endl;
    cin>>op;
    switch(op){
      case '+':  cout<<(a+b)<<endl;
        break;
      case '*':  cout<<(a*b)<<endl;
        break;
      case '/':  cout<<(a/b)<<endl;
      break;
      case '%':  cout<<(a%b)<<endl;
      break;
      default: cout<<"bsdk koi operation to bata konsa kru"<<endl;     
    }
    cout<<endl;
    return 0;
}
